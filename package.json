{
  "name": "cfx-portal-upload",
  "description": "Re-Upload your escrow resources to portal.cfx.re using GitHub Actions",
  "version": "0.0.0",
  "author": "",
  "private": true,
  "homepage": "https://github.com/Tynopia/cfx-portal-upload",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tynopia/cfx-portal-upload.git"
  },
  "bugs": {
    "url": "https://github.com/Tynopia/cfx-portal-upload/issues"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint . -c ./.github/linters/.eslintrc.yml",
    "package": "npx ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "package:watch": "npm run package -- --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@puppeteer/browsers": "^2.6.1",
    "axios": "^1.7.9",
    "form-data": "^4.0.1",
    "puppeteer": "^23.10.4",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/yazl": "^2.4.6",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^8.57.0",
    "eslint-plugin-jsonc": "^2.18.2",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "prettier-eslint": "^16.3.0",
    "typescript": "^5.7.2"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  }
}
